var exist = function(board, word) {
    let alreadyVisit = [];
    let row = board.length;
    let col = board[0].length;
    for(let i=0;i<row;i++){
        alreadyVisit[i]=[];
        for(let j=0;j<col;j++){
            alreadyVisit[i][j] = false;
        }
    }
    function helper(r,c,index){
        if(index === word.length)return true;
    if(r<0 || c<0 || r>=row || c>=col || board[r][c]!==word[index]||alreadyVisit[r][c]){
            return false;
        }
        alreadyVisit[r][c] = true;
       let result =  helper(r+1,c,index+1)||
       helper(r-1,c,index+1)||
       helper(r,c+1,index+1)||
       helper(r,c-1,index+1);
       alreadyVisit[r][c] = false;
       return result;
    }
    for(let i=0;i<row;i++){
        for(let j=0;j<col;j++){
            if(helper(i,j,0))return true;
        }
    }
    return false;
    
};
