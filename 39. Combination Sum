var combinationSum = function(candidates, target) {
    let result = [];
    function helper (arr,start,total){
        if(total === target){
            result.push([...arr]);
            return;
        }
        if(total > target){
            return;
        }
        for(let i=start;i<candidates.length;i++){
            arr.push(candidates[i]);
            helper(arr,i,total+candidates[i]);
            arr.pop();
        }
    }
    console.log(result);
    helper([],0,0);
    return result;
}
console.log(combinationSum([2,3,6,7],7));
