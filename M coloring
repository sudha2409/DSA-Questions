class Solution {
    graphColoring(v, edges, m) {
        // code here
        let adj = [];
        for(let i=0;i<v;i++){
            adj.push([]);
        }
        //jo node jise connect h vo dalenge adj me 
        for(let i=0;i<edges.length;i++){
            let fromNode = edges[i][0];
            let toNode = edges[i][1];
            adj[fromNode].push(toNode);
            adj[toNode].push(fromNode);
        }
        //color me initally put 0
        let color = [];
        // color =    new Array(v).fill(0);
        for(let i=0;i<v;i++){
            color.push(0);
        }
        //adjacent node ke pass same color toh nhi
        function isSafe(node,col){
            for(let i=0;i<adj[node].length;i++){
                let neighbourAdj = adj[node][i];
                if(color[neighbourAdj] === col)return false;
                
            }
            return true; //adjacent ke pass same nhi h;
        }
         //try color on each node one by one
        //m is the color given
        function tryColor(node){
            if(node===v)return true;
            for(let i=1;i<=m;i++){
                if(isSafe(node,i)){
                    color[node]=i;
                   if(tryColor(node+1)) return true;
                    color[node] = 0;
                    
                }
                
            }
            return false;
        }

    // console.log(color);
          return tryColor(0);
    }
  
}

