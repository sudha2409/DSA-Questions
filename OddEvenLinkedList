var oddEvenList = function(head) {
    if (!head || !head.next) return head;
    let odd = head;
    let even = head?.next;
    let lastJoinEven =  head?.next ;
    while(even !== null && even.next !== null){
        odd.next = odd.next.next;
        even.next = even.next.next;

        odd = odd.next;
        even = even.next; 
    }
    odd.next = lastJoinEven;
    return head;
    
};
